# Copy to .env inside your brain dir (~/standin-data by default). Never commit .env.
# The HANDS layer: your own tokens, used only on your machine.

# Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY=

# Slack bot token for approve-to-send messages (optional in v1)
SLACK_BOT_TOKEN=

# Model for triage classification (optional; defaults to your Claude Code default)
# STANDIN_MODEL=claude-sonnet-5
